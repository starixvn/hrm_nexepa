@using System.Configuration;
@using NexEPA.Resources;
@using NexEPA.Web.Models;

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
    var menuGroups = SessionManager.CurrentUser.MenuGroups as IEnumerable<MenuGroup>;
    var index = 1;
}
<div class="row header">
	<a href="~/" class="col-xs-12 col-sm-2 logo">
		<img src="~/content/site/images/logo.png" title="NexEPA" alt="NexEPA" />
	</a>
	<div class="col-xs-12 col-sm-10">
		<nav id="navbar-example" class="navbar navbar-static top-menu" role="navigation">
            <div class="bs-example-js-navbar-collapse">
                <ul class="nav navbar-nav">
                    @foreach (var menuParentItem in menuGroups)
                    {
                        var childMenuItems = menuParentItem.MenuItems;

                        if (childMenuItems != null && childMenuItems.Count() > 0)
                        {
                            var id = "drop" + index;
                            
                            <li class="dropdown">
                                <a id="@id" href="#" data-role="button" class="dropdown-toggle" data-toggle="dropdown">@menuParentItem.Name<b class="caret"></b>
                                </a>
                                <ul class="dropdown-menu" data-role="button" aria-labelledby="@id">
                                    @foreach (var childMenu in childMenuItems) 
                                    {
                                        <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="@childMenu.Url">@childMenu.Name</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                    
                            index += 1;
                        }
                        else
                        {
                            <li>
                                <a href="@menuParentItem.Url" >@menuParentItem.Name</a>
                            </li>
                        }
                    }

                    @if (ConfigurationManager.AppSettings["IsSimulatedLoginUser"].ToString().Equals("true"))
                    {
                        <li>
                            <a href="#" id="drop3" role="button" class="dropdown-toggle" data-toggle="dropdown">Test <b class="caret"></b></a>
                            <ul class="dropdown-menu" data-role="menu" aria-labelledby="drop2">
                                <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Test/LoginAsAnotherUser">Login as another user</a></li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </nav>
		<div class="user-info info" ng-controller="LogoutController">
			<div class="username">
				<span ng-mouseover="isShowMenu = !isShowMenu">@ViewBag.User</span>
			</div>
			<a class="dropdown-arrow" href="javascript:;" ng-click="isShowMenu = !isShowMenu">
			</a>
			<ol ng-show="isShowMenu">
				<li>
					<a href="" ng-click="logout()">Logout</a>
				</li>
			</ol>
		</div>
	</div>
</div>
<div class="row" data-ng-view>
</div>
