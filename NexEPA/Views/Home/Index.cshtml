@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row header">
    <a href="#" class="col-sm-2 logo">
        <img src="~/content/site/images/logo.png" title="NexEPA" alt="NexEPA" />
    </a>
    <div class="col-sm-10">
        <nav id="navbar-example" class="navbar navbar-static top-menu" role="navigation">
            <div class="collapse navbar-collapse bs-example-js-navbar-collapse">
                <ul class="nav navbar-nav">
                <li>
                    <a href="~/">Home</a>
                </li>
                <li>
                    <a href="/Employee/GetAllEmployee">Employee</a>
                </li>
                @if (Roles.IsUserInRole("PM") || Roles.IsUserInRole("SA"))
                { 
                <li class="dropdown">
                    <a id="drop1" href="#" data-role="button" class="dropdown-toggle" data-toggle="dropdown">Project <b class="caret"></b></a>
                    <ul class="dropdown-menu" data-role="button" aria-labelledby="drop1">
                    
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="~/Projects/Index">Project</a></li>
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Target/ViewTarget">Target</a></li>
                    </ul>
                </li>
                }
                <li class="dropdown">
                    <a id="drop2" href="#" data-role="button" class="dropdown-toggle" data-toggle="dropdown">EPA <b class="caret"></b></a>
                    <ul class="dropdown-menu" data-role="menu" aria-labelledby="drop1">
					<li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/MemberEPA/ViewCurrentMember">My EPA</a></li>
                    @if (Roles.IsUserInRole("SA") || Roles.IsUserInRole("PM") || Roles.IsUserInRole("Leader"))
                    {
                        <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/MemberEPA/ViewMember">Member EPA</a></li> 
                    }
                    </ul>
                </li>
                @if (Roles.IsUserInRole("SA") || Roles.IsUserInRole("PM") || Roles.IsUserInRole("Leader"))
                {
                <li class="dropdown">
                    <a href="#" id="drop3" role="button" class="dropdown-toggle" data-toggle="dropdown">Report <b class="caret"></b></a>
                    <ul class="dropdown-menu" data-role="menu" aria-labelledby="drop2">
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Report/EmployeePerformanceTendency">Employee Performance Tendency</a></li>
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Report/EmployeePerformanceByTeam">Employee Performance By Team</a></li>
                   </ul>
                </li>
                }
                @if (Roles.IsUserInRole("SA"))
                { 
                <li class="dropdown">
                    <a href="#" id="drop3" role="button" class="dropdown-toggle" data-toggle="dropdown">Admin <b class="caret"></b></a>
                    <ul class="dropdown-menu" data-role="menu" aria-labelledby="drop2">
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/KPI/ViewKPI">KPI</a></li>
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/KPI/GetAllKPIGroup">KPI Group</a></li>
                    <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/TargetTemplate/Index">Target Template</a></li>
					<li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Setting/Index">Settings</a></li>
                   </ul>
                </li>
                }
                </ul>
            </div>
        </nav>
        <ul class="list-inline info">
            <li><span class="glyphicon glyphicon-user"></span>@ViewBag.User</li>
        </ul>
    </div>
</div>
<div class="row" data-ng-view>
</div>